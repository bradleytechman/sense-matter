{
  "pluginAlias": "SenseMatter",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "username": {
        "title": "Sense Email",
        "type": "string",
        "required": true
      },
      "password": {
        "title": "Sense Password",
        "type": "string",
        "required": true,
        "format": "password"
      },
      "monitorId": {
        "title": "Monitor ID (optional)",
        "type": "string",
        "description": "Leave blank to use the first monitor on the account"
      },
      "mfaType": {
        "title": "Multi-Factor Authentication",
        "type": "string",
        "enum": ["Disabled", "TOTP"],
        "default": "Disabled",
        "description": "Select TOTP if your Sense account has MFA enabled"
      },
      "mfaSecret": {
        "title": "MFA Secret (base32)",
        "type": "string",
        "description": "The base32 secret from when you set up MFA. See the README for how to get it.",
        "condition": {
          "functionBody": "return model.mfaType === 'TOTP';"
        }
      },
      "pollingInterval": {
        "title": "Polling Interval (seconds)",
        "type": "integer",
        "default": 30,
        "minimum": 10
      },
      "deviceType": {
        "title": "Device Type",
        "type": "string",
        "enum": ["sensor", "outlet"],
        "default": "sensor",
        "description": "sensor = ElectricalSensor (Energy section only, no room tile). outlet = OnOffOutlet (room tile with live watts; energy still in Energy view). Change requires restart + re-pair."
      }
    }
  },
  "layout": [
    {
      "type": "section",
      "title": "Sense Account",
      "items": ["username", "password", "monitorId"]
    },
    {
      "type": "section",
      "title": "Multi-Factor Authentication",
      "items": ["mfaType", "mfaSecret"]
    },
    {
      "type": "section",
      "title": "Appearance & Advanced",
      "expandable": true,
      "items": ["deviceType", "pollingInterval"]
    }
  ]
}
